{% extends 'base.html.twig' %}

{% block body %}
    <h1>Клиенты</h1>
    
    <a href="{{ path('app_client_new') }}" class="btn btn-primary">Добавить клиента</a>
    
    <table>
        <thead>
            <tr>
                <th>Имя</th>
                <th>Телефон</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        {% for client in clients %}
            <tr>
                <td>{{ client.name }}</td>
                <td>{{ client.phone ?? 'Не указан' }}</td>
                <td>
                    <a href="{{ path('app_client_show', {'id': client.id}) }}" class="btn btn-primary">Просмотр</a>
                    <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="btn btn-success">Изменить</a>
                    {{ include('client/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Клиентов нет</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
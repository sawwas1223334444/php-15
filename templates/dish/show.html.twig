{% extends 'base.html.twig' %}

{% block title %}{{ dish.name }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ dish.name }}</h1>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Информация о блюде</h5>
                        <table class="table">
                            <tr>
                                <th>Название</th>
                                <td>{{ dish.name }}</td>
                            </tr>
                            <tr>
                                <th>Цена</th>
                                <td>{{ dish.price }} руб.</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Фото блюда</h5>
                        
                        {% if dish.imageName %}
                            <img src="{{ vich_uploader_asset(dish, 'imageFile') }}" 
                                 alt="{{ dish.name }}" 
                                 class="img-fluid mb-3 rounded" 
                                 style="max-height: 300px; width: auto;">
                            
                            <form method="post" 
                                  action="{{ path('app_dish_delete_image', {'id': dish.id}) }}" 
                                  onsubmit="return confirm('Удалить фото?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-image' ~ dish.id) }}">
                                <button class="btn btn-danger">
                                    <i class="fas fa-trash"></i> Удалить фото
                                </button>
                            </form>
                        {% else %}
                            <img src="/images/placeholder.jpg" 
                                 alt="Заглушка" 
                                 class="img-fluid mb-3 rounded" 
                                 style="max-height: 300px; width: auto;">
                            <p class="text-muted">Фото не загружено</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a href="{{ path('app_dish_edit', {'id': dish.id}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Редактировать
            </a>
            <a href="{{ path('app_dish_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Назад к списку
            </a>
            
            <form method="post" action="{{ path('app_dish_delete', {'id': dish.id}) }}" 
                  style="display: inline-block;" 
                  onsubmit="return confirm('Удалить блюдо?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dish.id) }}">
                <button class="btn btn-danger">
                    <i class="fas fa-trash"></i> Удалить блюдо
                </button>
            </form>
        </div>
    </div>
{% endblock %}
<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">
            Файлы заказа
            <a href="{{ path('app_order_file_index', {'orderId': order.id}) }}" class="btn btn-sm btn-primary float-end">
                <i class="fas fa-folder-open"></i> Управление файлами
            </a>
        </h5>
    </div>
    <div class="card-body">
        {% if order.files|length > 0 %}
            <div class="list-group">
                {% for file in order.files %}
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <i class="{{ file.getIconClass() }} me-2"></i>
                            <strong>{{ file.originalName }}</strong>
                            <small class="text-muted ms-2">({{ (file.size / 1024)|round(2) }} KB)</small>
                        </div>
                        <div>
                            <a href="{{ path('app_order_file_download', {'orderId': order.id, 'id': file.id}) }}" 
                               class="btn btn-sm btn-success" title="Скачать">
                                <i class="fas fa-download"></i>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted mb-0">Нет прикрепленных файлов.</p>
        {% endif %}
    </div>
</div>